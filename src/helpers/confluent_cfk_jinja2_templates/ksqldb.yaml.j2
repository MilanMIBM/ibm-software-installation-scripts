{#- KsqlDB (set platform, order 60). Interactive mode only (CFK has no headless mode). -#}
{% import "_macros.yaml.j2" as mac %}
apiVersion: platform.confluent.io/v1beta1
kind: KsqlDB
{{ mac.metadata(c.name, m.ns, m.labels) }}
spec:
  replicas: 1
{{ mac.image(c) }}
  dataVolumeCapacity: {{ c.storage | q }}
  storageClass:
    name: {{ m.storage_class | q }}
{{ mac.pod_template(c) }}
{{ mac.common_tail(c, m) }}
  dependencies:
    kafka: {{ c.kafka | j }}
{% if c.sr %}
    schemaRegistry: {{ c.sr | j }}
{% endif %}
{% if c.connect %}
    connect: {{ c.connect | j }}
{% endif %}
  configOverrides:
    server:
{% for line in c.server_overrides %}
      - {{ line | q }}
{% endfor %}
