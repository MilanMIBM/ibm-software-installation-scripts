{#- sasl_mechanism takes the Kafka spelling (PLAIN, SCRAM-SHA-256, SCRAM-SHA-512);
    the connection form wants it lower-case with underscores (scram_sha_512).
    Defaults match the Confluent EXTERNAL listener: SASL_SSL with PLAIN. -#}
{%- set _mechanism = sasl_mechanism | default("PLAIN") | upper -%}
{
    "display_name": {{ display_name | tojson }},
    "type": "kafka",
    "description": {{ description | default("Confluent Kafka Connector") | truncate(50, true, "") | tojson }},
    "tags": {{ tags | default([]) | tojson }},

    "associated_catalog": {
        "catalog_name": {{ catalog_name | tojson }},
        "catalog_type": {{ catalog_type | default("iceberg") | tojson }}
    },

    "connection": {
        "hostname": {{ broker_host | tojson }},
        "port": {{ broker_port | int }},
        "certificate": {{ certificate | default("") | tojson }},
        "certificate_extension": {{ certificate_extension | default("crt") | tojson }},
        "connection_method": {{ connection_method | default("basic") | tojson }},
        "sasl_mechanism": {{ _mechanism | lower | replace("-", "_") | tojson }},
        "password": {{ broker_authentication_password |  default("") | tojson }},
        "username":  {{ broker_authentication_user | default("") | tojson }},
        "validate_server_certificate": {{ validate_server_certificate | default(true) | tojson }},
        "verify_host_name": {{ verify_host_name | default(true) | tojson }},
        "sasl": {{ sasl | default(true) | tojson }}
    },

    "properties": [
        {
        "encrypt":false,
        "key":"connector.name",
        "value":"kafka"
        },
        {
        "encrypt": false,
        "key": "kafka.nodes",
        "value": {{ hosts | tojson }}
        },
        {
        "encrypt": false,
        "key":"kafka.hide-internal-columns",
        "value":"false"
        },
        {
        "encrypt": false,
        "key": "kafka.security-protocol",
        "value": {{ security_protocol | default("SASL_SSL") | tojson }}
        },
        {
        "encrypt": false,
        "key": "kafka.sasl.mechanism",
        "value": {{ _mechanism | tojson }}
        }
    ]
}
