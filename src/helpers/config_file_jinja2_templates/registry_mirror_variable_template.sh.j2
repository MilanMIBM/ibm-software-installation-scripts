#!/bin/zsh
# ==============================================================================
# Private registry mirroring configuration
# Generated by 0.0_generate_mirror_config.sh on {{ generated_at }}
# ==============================================================================
# Sourced (never executed) by scripts/private_registry_mirroring/*, which run with
# ENV_TARGET=registry_mirror (or MIRROR_CONFIG_FILE=<this file>). Skipped in every
# other context, so install scripts never see these values; installs are pointed
# at the registry by 3.5, which writes configs/<install>_config/registry_overrides.sh.
#
#   Interactive shell:  source s_env.sh registry_mirror
#
# Re-running the generator keeps every value set here and only adds new settings.
# NOTHING IS MIRRORED until MIRROR_INSTALLS and an install's COMPONENTS + CONTENT
# below are filled in.
[[ "${ENV_TARGET:-}" == registry_mirror || "${ENV_TARGET:-}" == *registry_mirror_vars.sh ]] || return 0

export MIRROR_CONFIG_VERSION="1"

# ------------------------------------------------------------------------------
# cpd-cli behaviour
# ------------------------------------------------------------------------------
# skopeo-inspect every IBM source image (list-images --inspect_source_registry) in
# 1.1 and before mirroring: catches entitlement problems early, but adds 1-2 h.
# An exported value wins, e.g. MIRROR_CPD_INSPECT_SOURCE_REGISTRY=true ./full_...sh
export MIRROR_CPD_INSPECT_SOURCE_REGISTRY="${MIRROR_CPD_INSPECT_SOURCE_REGISTRY:-false}"
# Pass -v to the cpd-cli commands that support it (mirror-images).
export MIRROR_CPD_VERBOSE="${MIRROR_CPD_VERBOSE:-true}"
# Push MIRROR_CPD_PARALLEL_JOBS CASEs at a time (mirror-images writes the mapping
# files, the same oc image mirror per CASE runs in parallel). false = IBM's own
# serial run (one CASE, one upload at a time). Set by 0.0_generate_mirror_config.sh
# on every run (--cpd-parallel / --cpd-parallel-jobs), not kept from this file.
export MIRROR_CPD_PARALLEL="${MIRROR_CPD_PARALLEL:-true}"
export MIRROR_CPD_PARALLEL_JOBS="${MIRROR_CPD_PARALLEL_JOBS:-6}"

# ------------------------------------------------------------------------------
# Registry
# ------------------------------------------------------------------------------
# Image source:
#   private  cloud / remote private registry (e.g. ICR private.de.icr.io/<namespace>);
#            the install workstation stays online
#   local    local private registry for air-gapped installs (device, bastion,
#            on-prem host inside the disconnected network)
#   auto     decide from the registry host (0.1_detect_registry.sh shows why)
export MIRROR_IMAGE_SOURCE="auto"
# Registry root the CLUSTER pulls from: <host>[:port][/<namespace>]. Every install
# gets its own path below it (<root>/cpd, <root>/confluent, ...) plus <root>/shared.
# Empty = the local registry started by 0.3_local_registry.sh.
export MIRROR_REGISTRY_ROOT=""
# Where THIS workstation pushes: "local" (default) = from outside IBM Cloud, so an
# ICR private endpoint (private.<region>.icr.io) is pushed through its public
# endpoint (<region>.icr.io); "cloud" = push where the cluster pulls (bastion
# inside IBM Cloud). MIRROR_REGISTRY_PUSH_ROOT overrides the derived value.
export MIRROR_REGISTRY_PUSH_FROM="local"
export MIRROR_REGISTRY_PUSH_ROOT=""
# Push credentials (mirroring). ICR: user "iamapikey", password = API key.
export MIRROR_REGISTRY_PUSH_USER=""
export MIRROR_REGISTRY_PUSH_PASSWORD=""
# Pull credentials (cluster + install workstation). Least privilege: a read-only key.
export MIRROR_REGISTRY_PULL_USER="${MIRROR_REGISTRY_PUSH_USER}"
export MIRROR_REGISTRY_PULL_PASSWORD="${MIRROR_REGISTRY_PUSH_PASSWORD}"
# CA of a registry with its own certificate (local registries); trusted by the
# cluster in 3.2. 0.3_local_registry.sh fills it in for its own registry.
export MIRROR_REGISTRY_CA_FILE=""
# Last resort for registries without valid TLS: cluster insecureRegistries entry.
export MIRROR_REGISTRY_INSECURE="false"

# ------------------------------------------------------------------------------
# Sources (needed on the internet side only)
# ------------------------------------------------------------------------------
# IBM entitlement key (cp.icr.io) - https://myibm.ibm.com/products-services/containerlibrary
export MIRROR_IBM_ENTITLEMENT_KEY=""
# Red Hat pull secret (registry.redhat.io etc.) for operator catalogs and Red Hat
# images - download from https://console.redhat.com/openshift/install/pull-secret
export MIRROR_REDHAT_PULL_SECRET_FILE="${REGISTRY_MIRROR_CONFIG_DIR:-.}/redhat-pull-secret.json"
# Optional Docker Hub login (anonymous pulls are rate limited).
export MIRROR_DOCKERHUB_USER=""
export MIRROR_DOCKERHUB_TOKEN=""

# ------------------------------------------------------------------------------
# Transport
# ------------------------------------------------------------------------------
# direct    one machine reaches both the internet and the registry
# stopover  carry everything across the air gap on disk: --phase=save on the
#           internet side, move MIRROR_BUNDLE_DIR, --phase=load inside
export MIRROR_TRANSPORT="direct"
# auto | mirror | save | load (auto: from what is reachable; --phase= wins)
export MIRROR_PHASE="auto"
# Stop-over bundle (e.g. /Volumes/USB/swh-bundle). Empty = registry_mirror_workspace/bundle
export MIRROR_BUNDLE_DIR=""
# Inside workstation for the stop-over: linux (assumed) | darwin | linux,darwin
export MIRROR_INSIDE_PLATFORM="linux"
# Parallel pushes per registry for oc image mirror.
export MIRROR_PARALLEL="4"

# ------------------------------------------------------------------------------
# Cluster
# ------------------------------------------------------------------------------
# Which install's config logs in to the cluster (default: the first in
# MIRROR_INSTALLS that has OC_LOGIN), or an explicit login command.
export MIRROR_CLUSTER_FROM=""
export MIRROR_OC_LOGIN=""
# OpenShift minor for operator catalogs (e.g. 4.20). Required when the cluster is
# not reachable from the mirroring machine; otherwise read from the cluster.
export MIRROR_OCP_MINOR=""
# How installs other than CP4D are pointed at the registry:
#   both         explicit overrides in the install's config + IDMS/ITMS (default)
#   explicit     only the install's own image settings (ROSA: avoid mirror sets)
#   mirror-sets  only IDMS/ITMS (pods keep their original image names)
export MIRROR_CLUSTER_REDIRECT="both"
# Disable the default OperatorHub catalogs and serve the mirrored ones under the
# same names (redhat-operators, ...). auto = true for local, false for private.
export MIRROR_DISABLE_DEFAULT_CATALOGS="auto"
# oc-mirror also writes an OLM v1 ClusterCatalog; this repo uses OLM v0 Subscriptions.
export MIRROR_APPLY_CLUSTERCATALOG="false"

# ==============================================================================
# WHAT TO MIRROR - empty means nothing
# ==============================================================================
# Installs to mirror for: {{ install_ids | join(",") }}
export MIRROR_INSTALLS=""
{% for i in installs %}

{{ i.partial }}
{%- endfor %}

# ------------------------------------------------------------------------------
# Local registry (0.3_local_registry.sh)
# ------------------------------------------------------------------------------
# distribution    docker.io/library/registry:2 under podman (macOS or Linux)
# mirror-registry Red Hat's mirror registry (Quay) - RHEL x86 bastion, long-lived
export LOCAL_REGISTRY_ENGINE="distribution"
# Host name the cluster nodes use to reach this machine (must resolve inside the
# cluster network and is put into the TLS certificate). Empty = this host's FQDN.
export LOCAL_REGISTRY_HOST=""
export LOCAL_REGISTRY_PORT="5000"
# Optional namespace below the host (<host>:<port>/<namespace>)
export LOCAL_REGISTRY_NAMESPACE=""
# Storage (needs room for everything selected above; see 1.2_estimate_size.sh).
# Empty = registry_mirror_workspace/local-registry/data
export LOCAL_REGISTRY_DIR=""
