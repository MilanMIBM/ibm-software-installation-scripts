#===============================================================================
# IBM Software Hub installation variables
#===============================================================================

_CPD_VARS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
[ -f "${_CPD_VARS_DIR}/.env" ] && source "${_CPD_VARS_DIR}/.env"
unset _CPD_VARS_DIR

# ------------------------------------------------------------------------------
# Client workstation 
# ------------------------------------------------------------------------------
# Set the following variables if you want to override the default behavior of the IBM Software Hub CLI.
#
# To export these variables, you must uncomment each command in this section.

# export CPD_CLI_MANAGE_WORKSPACE=<enter a fully qualified directory>
# export OLM_UTILS_LAUNCH_ARGS=<enter launch arguments>

# ------------------------------------------------------------------------------
# Cluster
# ------------------------------------------------------------------------------

# local   = chains run on this machine.
# cluster = chains run in a pod on the cluster, so this machine can go off: see
#           "Running an install in the cluster" in the README.
export INSTALL_RUN_MODE="{{ install_run_mode | default('local', true) }}"

# In-cluster runner settings, read only with INSTALL_RUN_MODE=cluster. A commented
# line shows the built-in default; uncomment it to change it.
#   STORAGE_CLASS       storage class for the runner's volume (empty: STG_CLASS_BLOCK)
#   IMAGE_SOURCE        build-in-cluster, build-local-push or prebuilt
#   IMAGE               a prebuilt runner image (empty IMAGE_SOURCE then means prebuilt)
#   PVC_SIZE            size of the runner's volume
#   AUTO_RESUME         a new pod continues the run when the pod is lost
#   MAX_RESUMES         how many times it does that
#   KEEP_ADMIN          keep the runner's cluster-admin after the run
#   NODE_SELECTOR       key=value, to keep the runner pod on matching nodes
#   TTY_SIZE            terminal size of the run, columns x rows
#   ROLLOUT_TIMEOUT     seconds to wait for a changed runner pod to come up
#   SWHCC_IMAGE         a mirrored Software Hub Premium image for Control Center in
#                       the pod (empty: imported from cp.icr.io into the internal registry)
#   SWHCC_PULL_SECRET   a pull secret for SWHCC_IMAGE, already in the slot's namespace
#   SWHCC_MEMORY_LIMIT  memory limit of the Control Center sidecar
{% for _name, _default in [
    ("INSTALL_RUNNER_STORAGE_CLASS", ""),
    ("INSTALL_RUNNER_IMAGE_SOURCE", "build-in-cluster"),
    ("INSTALL_RUNNER_IMAGE", ""),
    ("INSTALL_RUNNER_PVC_SIZE", "20Gi"),
    ("INSTALL_RUNNER_AUTO_RESUME", "true"),
    ("INSTALL_RUNNER_MAX_RESUMES", "3"),
    ("INSTALL_RUNNER_KEEP_ADMIN", "false"),
    ("INSTALL_RUNNER_NODE_SELECTOR", ""),
    ("INSTALL_RUNNER_TTY_SIZE", "120x50"),
    ("INSTALL_RUNNER_ROLLOUT_TIMEOUT", "900"),
    ("INSTALL_RUNNER_SWHCC_IMAGE", ""),
    ("INSTALL_RUNNER_SWHCC_PULL_SECRET", ""),
    ("INSTALL_RUNNER_SWHCC_MEMORY_LIMIT", "4Gi"),
] -%}
{% set _value = ((install_runner_settings | default({}, true)).get(_name) or "") | string | trim -%}
{% if _value -%}
export {{ _name }}="{{ _value }}"
{% else -%}
# export {{ _name }}="{{ _default }}"
{% endif -%}
{% endfor %}
export OCP_URL="{{ cluster_url_input.value }}"
export OPENSHIFT_TYPE="{{ cluster_type_select.value }}"
export IMAGE_ARCH="{{ cluster_arch_select.value }}"
{% if login_argument_select.selected_key == "Username/Password" -%}
export OCP_USERNAME="{{ cluster_username_input.value }}"
export OCP_PASSWORD="{{ cluster_password_input.value }}"
export LOGIN_ARGUMENTS="--username=${OCP_USERNAME} --password=${OCP_PASSWORD}"
{% elif login_argument_select.selected_key == "Token" -%}
export OCP_TOKEN="{{ cluster_token_input.value }}"
export LOGIN_ARGUMENTS="--token=${OCP_TOKEN}"
{% endif -%}

export SERVER_ARGUMENTS="--server=${OCP_URL}"
export OC_LOGIN="oc login ${SERVER_ARGUMENTS} ${LOGIN_ARGUMENTS}"
export CPDM_OC_LOGIN="cpd-cli manage login-to-ocp ${SERVER_ARGUMENTS} ${LOGIN_ARGUMENTS}"

# ------------------------------------------------------------------------------
# Projects
# ------------------------------------------------------------------------------

export PROJECT_LICENSE_SERVICE="{{ cp4d_install_project_naming.get("PROJECT_LICENSE_SERVICE") }}"
export PROJECT_SCHEDULING_SERVICE="{{ cp4d_install_project_naming.get("PROJECT_SCHEDULING_SERVICE") }}"
{% if cp4d_install_project_naming.get("PROJECT_IBM_EVENTS") -%}
export PROJECT_IBM_EVENTS="{{ cp4d_install_project_naming.get("PROJECT_IBM_EVENTS") }}"
{% endif -%}
{% if cp4d_install_project_naming.get("PROJECT_PRIVILEGED_MONITORING_SERVICE") -%}
export PROJECT_PRIVILEGED_MONITORING_SERVICE="{{ cp4d_install_project_naming.get("PROJECT_PRIVILEGED_MONITORING_SERVICE") }}"
{% endif -%}
{% if cp4d_install_project_naming.get("PROJECT_SW_HUB_CONTROL_CENTER_OPERATORS") -%}
export PROJECT_SW_HUB_CONTROL_CENTER_OPERATORS="{{ cp4d_install_project_naming.get("PROJECT_SW_HUB_CONTROL_CENTER_OPERATORS") }}"
{% endif -%}
{% if cp4d_install_project_naming.get("PROJECT_SW_HUB_CONTROL_CENTER_OPERANDS") -%}
export PROJECT_SW_HUB_CONTROL_CENTER_OPERANDS="{{ cp4d_install_project_naming.get("PROJECT_SW_HUB_CONTROL_CENTER_OPERANDS") }}"
{% endif -%}
export PROJECT_CPD_INST_OPERATORS="{{ cp4d_install_project_naming.get("PROJECT_CPD_INST_OPERATORS") }}"
export PROJECT_CPD_INST_OPERANDS="{{ cp4d_install_project_naming.get("PROJECT_CPD_INST_OPERANDS") }}"

# ------------------------------------------------------------------------------
# Storage
# ------------------------------------------------------------------------------

export STG_CLASS_BLOCK="{{ block_storage_class_select.value }}"
export STG_CLASS_FILE="{{ file_storage_class_select.value }}"
# ------------------------------------------------------------------------------
# Service-instance credentials
# ------------------------------------------------------------------------------
# The service-instance scripts (4.5_*, 5_*) and the instance manager TUI save each
# instance's credentials to managed-service-instances/<type>/<instance>-instance_details.sh
# next to this file, and while SERVICE_INSTANCE_VAULT_STORE is true also as a secret
# '<type>-<instance>' in the Software Hub internal vault, owned by CPD_USERNAME and shared
# with SERVICE_INSTANCE_VAULT_MEMBERS (comma-separated usernames; group:<id|name> for groups).
export SERVICE_INSTANCE_VAULT_STORE="true"
export SERVICE_INSTANCE_VAULT_MEMBERS="cpadmin"
# ------------------------------------------------------------------------------
# IBM Entitled Registry Key
# ------------------------------------------------------------------------------
{% if image_pull_creds_select.selected_key != "IBM Entitled Registry" -%}
# Still required: mirroring (scripts/private_registry_mirroring/) pulls the
# images from cp.icr.io with this key. The cluster pulls from the registry below.
{% endif %}
export IBM_ENTITLEMENT_KEY="{{ ibm_entitlement_key_input.value }}"
{% if image_pull_creds_select.selected_key != "IBM Entitled Registry" %}
# ------------------------------------------------------------------------------
# Private container registry
# ------------------------------------------------------------------------------
# private = cloud/remote registry; local = local private registry (air-gapped).
# scripts/private_registry_mirroring/ mirrors the images and writes
# registry_overrides.sh next to this file (sourced after it) with the exact
# registry path, OLM_UTILS_IMAGE and, for local, CPD_CASE_SOURCE=offline.
export CPD_IMAGE_SOURCE="{{ 'local' if image_pull_creds_select.selected_key == 'Local Private Registry (air-gapped)' else 'private' }}"
export PRIVATE_REGISTRY_LOCATION="{{ cp4d_private_registry_naming.get("PRIVATE_REGISTRY_LOCATION") }}"
export PRIVATE_REGISTRY_PUSH_USER="{{ cp4d_private_registry_naming.get("PRIVATE_REGISTRY_PUSH_USER") }}"
export PRIVATE_REGISTRY_PUSH_PASSWORD="{{ cp4d_private_registry_naming.get("PRIVATE_REGISTRY_PUSH_PASSWORD") }}"
export PRIVATE_REGISTRY_PULL_USER="{{ cp4d_private_registry_naming.get("PRIVATE_REGISTRY_PULL_USER") }}"
export PRIVATE_REGISTRY_PULL_PASSWORD="{{ cp4d_private_registry_naming.get("PRIVATE_REGISTRY_PULL_PASSWORD") }}"
{% if image_pull_creds_select.selected_key == "Local Private Registry (air-gapped)" %}
# Air-gapped: case-download reuses the CASE packages in cpd-cli's work dir,
# restored from the stop-over bundle (2.6_restore_transfer_bundle.sh) - nothing
# is fetched from github.com / icr.io. Images move with the mirror config's
# MIRROR_TRANSPORT="stopover" (--phase=save outside, --phase=load inside).
export CPD_CASE_SOURCE="offline"
{% endif -%}
{% endif -%}

# ------------------------------------------------------------------------------
# Image pull configuration
# ------------------------------------------------------------------------------

export IMAGE_PULL_SECRET="{{ pull_secret_name_input.value | default('pull-secret') }}"
{% if image_pull_creds_select.selected_key == "IBM Entitled Registry" -%}
export IMAGE_PULL_CREDENTIALS="$(echo -n "cp:$IBM_ENTITLEMENT_KEY" | base64 -w 0)"
export IMAGE_PULL_PREFIX="icr.io"
{% else -%}
export IMAGE_PULL_CREDENTIALS="$(echo -n "$PRIVATE_REGISTRY_PULL_USER:$PRIVATE_REGISTRY_PULL_PASSWORD" | base64 -w 0)"
export IMAGE_PUSH_CREDENTIALS="$(echo -n "$PRIVATE_REGISTRY_PUSH_USER:$PRIVATE_REGISTRY_PUSH_PASSWORD" | base64 -w 0)"
export IMAGE_PULL_PREFIX="${PRIVATE_REGISTRY_LOCATION}"
export IMAGE_PUSH_PREFIX="${PRIVATE_REGISTRY_LOCATION}"
{% endif -%}

# ------------------------------------------------------------------------------
# IBM Software Hub version
# ------------------------------------------------------------------------------

export VERSION="{{ cp4d_version_input.value }}"
export PATCH_ID="{{ cp4d_patch_input.value }}" # Number like 1, 2, 3 which corresponds to the patch to install. Current patch as of 25.10.2026 is "8" - Check for the latest version here https://github.com/IBM/software-hub/releases
export OLM_UTILS_IMAGE="icr.io/cpopen/cpd/olm-utils-v4:${VERSION}${PATCH_ID:+.${PATCH_ID}}" # you could also specify the architecture like ${VERSION}.${PATCH_ID}.${IMAGE_ARCH} (defaults to amd64) if you are using olm-utils-premium-v4 (not supported for olm-utils-v4)
export CPD_ADMIN_USERNAME="{{ cpd_admin_username_input.value }}"

# ------------------------------------------------------------------------------
# Components
# ------------------------------------------------------------------------------

export SOFTWARE_HUB="ibm-licensing,scheduler,cpfs,cpd_platform,ccs,zen"
export SOFTWAREHUB_SCALE="{{ softwarehub_scale_select.value }}" # level_2 (default zen size, no scale-config applied), level_3 or level_4
export SCHEDULER_SCALE="{{ scheduler_scale_select.value }}" # level_2 (default scheduler size, no scale-config applied), level_3 or level_4
export CPD_COMPONENTS="{{ components_to_install_str.split(',') | reject('equalto', 'ibm_wxd_opensearch') | join(',') }}"
export COMPLETE_COMPONENT_LIST="${SOFTWARE_HUB},${CPD_COMPONENTS}"
{% if optional_images_str -%}
export IMAGE_GROUPS="{{ optional_images_str }}"
{% endif -%}
export UPDATE="{{ updating_components_checkbox.value | lower }}"
# true: run the optional Software Hub Control Center sub-install at the very end of
# full_swhub_x_cpd_installprocess.sh. Its settings are in swhub_control_center/.
export INSTALL_SWHUB_CONTROL_CENTER="{{ (swhcc_enable_checkbox.value and swhcc_chain_checkbox.value) | lower }}"
export INSTALL_OPTIONS="{{ install_options_addon.value | lower }}"
{% if install_options_addon.value == true -%}
export INSTALL_OPTIONS_FILE="{{ inst_options_filename }}"
{% endif -%}

# ------------------------------------------------------------------------------
# License Entitlements
# ------------------------------------------------------------------------------

export PROD_LICENSE="{{ licenses_are_prod_checkbox.value | lower }}"
export LICENSE_ENTITLEMENTS="{{ entitlements_to_apply_str }}"

# ------------------------------------------------------------------------------
# Product Specific SCC requirements
# ------------------------------------------------------------------------------

{% if components_to_install_str.split(',') | select('in', ['db2oltp', 'db2wh', 'db2aaservice', 'openpages', 'watsonx_governance']) | list -%}
export PREP_DB2="true"
{% endif -%}
{% if 'ibm_wxd_opensearch' in components_to_install_str.split(',') -%}
export PREP_OPENSEARCH="true"
{% endif -%}
{% if 'informix' in components_to_install_str.split(',') or 'informix_cp4d' in components_to_install_str.split(',') -%}
export PREP_INFORMIX="true"
{% endif -%}
{% if 'edb_cp4d' in components_to_install_str.split(',') -%}
export PREP_EDB="true"
{% endif -%}
{% if 'watsonx_data_premium' in components_to_install_str.split(',') or 'datastax_mc' in components_to_install_str.split(',') -%}
export PREP_DATASTAX="true"
{% endif -%}
{% if 'planning_analytics' in components_to_install_str.split(',') -%}
export PREP_PA="true"
{% endif -%}
{% if 'cognos_analytics' in components_to_install_str.split(',') -%}
export PREP_CA="true"
{% endif -%}
{% if 'watsonx_orchestrate' in components_to_install_str.split(',') -%}
export PREP_WXO="true"
{% endif -%}