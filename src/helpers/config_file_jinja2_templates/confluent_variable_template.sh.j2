{#- Every value is written as export NAME="value" so the 0_*_prepare_template_config.sh
    scripts (which grep for ^export NAME=) recognise it and leave it untouched on re-runs.
    *_ENABLED flags keep the ${NAME:-value} form so the x.* utility scripts can override them. -#}
{%- macro export_block(vars) -%}
{% for key, value in vars.items() -%}
{% if key.endswith("_ENABLED") -%}
export {{ key }}="${{ '{' }}{{ key }}:-{{ value }}{{ '}' }}"
{% else -%}
export {{ key }}="{{ value }}"
{% endif -%}
{% endfor -%}
{%- endmacro -%}
#!/bin/zsh
# ==============================================================================
# Confluent Platform configuration - generated by confluent_platform_vars_generation.py
# ==============================================================================
# Sourced (never executed) by the confluent_install scripts, which run with
# ENV_TARGET=confluent so that THIS file is the only config in scope.
#
# Re-running 0_confluent_prepare_template_config.sh / 0_flink_prepare_template_config.sh
# rewrites only the managed sizing blocks below; every other value is preserved.

# ------------------------------------------------------------------------------
# Cluster foundation
# ------------------------------------------------------------------------------
# Must stay above the Confluent settings below, which reference them.
# ---- Cluster -----------------------------------------------------------------
export OCP_URL="{{ cluster_url_input.value }}"
{% if login_argument_select.selected_key == "Username/Password" -%}
export OCP_USERNAME="{{ cluster_username_input.value }}"
export OCP_PASSWORD="{{ cluster_password_input.value }}"
{% elif login_argument_select.selected_key == "Token" -%}
# CONFLUENT_AUTH_USERNAME defaults to the OpenShift login user.
export OCP_USERNAME="{{ cluster_username_input.value }}"
export OCP_TOKEN="{{ cluster_token_input.value }}"
{% endif -%}
export SERVER_ARGUMENTS="--server=${OCP_URL}"
export LOGIN_ARGUMENTS="{{ login_argument_select.value }}"
# Every script runs eval "${OC_LOGIN}" before touching the cluster.
export OC_LOGIN="oc login ${SERVER_ARGUMENTS} ${LOGIN_ARGUMENTS}"
# ---- Projects ----------------------------------------------------------------
# The Flink scripts derive their own project from this one.
export PROJECT_CONFLUENT_SERVER="{{ project_confluent_server_input.value }}"
# ---- Storage -----------------------------------------------------------------
# RWO for the broker PVCs, RWX for the Flink checkpoint PVC.
export STG_CLASS_BLOCK="{{ block_storage_class_select.value }}"
export STG_CLASS_FILE="{{ file_storage_class_select.value }}"

# ------------------------------------------------------------------------------
# Confluent Platform
# ------------------------------------------------------------------------------
# Topology from https://github.com/confluentinc/cp-all-in-one (KRaft variant).

# ---- Images ------------------------------------------------------------------
{{ export_block(confluent_images) }}
# ---- Component toggles -------------------------------------------------------
# The broker is always installed.
{{ export_block(confluent_component_toggles) }}
# ---- Ports -------------------------------------------------------------------
{{ export_block(confluent_ports) }}
# ---- Routes / waits ----------------------------------------------------------
{{ export_block(confluent_routes_and_waits) }}
# ---- Web UI authentication ---------------------------------------------------
# openshift = oauth-proxy sidecar + cluster login; basic = nginx basic auth.
{{ export_block(confluent_web_ui_auth) }}
# ---- Kafka client authentication (SASL/SCRAM) --------------------------------
{{ export_block(confluent_sasl) }}
# ---- Metadata Service (MDS) / RBAC -------------------------------------------
# Requires CONFLUENT_SASL_ENABLED=true. Licensed: empty key = 30-day trial.
{{ export_block(confluent_mds) }}
# ---- Bundled OpenLDAP (CONFLUENT_MDS_USER_STORE=LDAP) ------------------------
{{ export_block(confluent_ldap) }}
# ---- Keycloak / external OIDC (CONFLUENT_MDS_USER_STORE=OAUTH) ---------------
{{ export_block(confluent_oauth) }}
# ---- External Kafka access (passthrough routes + SASL_SSL) -------------------
# Requires CONFLUENT_SASL_ENABLED=true.
{{ export_block(confluent_external_access) }}
# >>> confluent sizing (managed by 0_confluent_prepare_template_config.sh) >>>
# Size: {{ size_select.value }}
# Re-run the script to change these; edits inside this block are overwritten.

# ---- Cluster sizing / storage / resources ------------------------------------
# KRaft cluster id must stay stable across reinstalls that reuse the broker PVCs.
export CONFLUENT_CLUSTER_ID="{{ cluster_id_input.value }}"
{{ export_block(confluent_sizing) -}}
# <<< confluent sizing (managed by 0_confluent_prepare_template_config.sh) <<<
{% if include_flink_checkbox.value %}
# >>> confluent flink (managed by flink_install/0_flink_prepare_template_config.sh) >>>
# Size: {{ size_select.value }}
# Re-run install_confluent_platform_flink_addon/0_flink_prepare_template_config.sh to change these;
# edits inside this block are overwritten.

{{ export_block(flink_sizing) -}}
# <<< confluent flink (managed by flink_install/0_flink_prepare_template_config.sh) <<<

# ------------------------------------------------------------------------------
# Confluent Platform for Apache Flink
# ------------------------------------------------------------------------------
# Delivered as two Helm charts: flink-kubernetes-operator and CMF
# (confluent-manager-for-apache-flink), both from packages.confluent.io/helm.

# ---- Helm ---------------------------------------------------------------------
{{ export_block(flink_helm) }}
# ---- Images -------------------------------------------------------------------
{{ export_block(flink_images) }}
# ---- cert-manager -------------------------------------------------------------
{{ export_block(flink_cert_manager) }}
# ---- CMF endpoint -------------------------------------------------------------
# The CMF REST API is unauthenticated as the chart ships it.
{{ export_block(flink_cmf_endpoint) }}
# ---- Environment / pool / catalog names ---------------------------------------
{{ export_block(flink_naming) }}
# ---- Job checkpoint / savepoint storage (pvc | s3 | none) ---------------------
{{ export_block(flink_state) }}
# ---- Confluent licence --------------------------------------------------------
{{ export_block(flink_license) -}}
{% endif %}
