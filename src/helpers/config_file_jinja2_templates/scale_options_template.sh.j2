# Scheduling service
#   cpd-cli manage apply-cluster-component-scale-config \
#     --cluster_component_ns=${PROJECT_SCHEDULING_SERVICE} \
#     --component=scheduler --scale=${SCALE} --release=${VERSION}
#   Check current scale with get-cluster-component-scale-config.
