################################################################################
# IBM Software Hub scale-options.yml
# Generated based on selected components
#
# This file documents the scaling options for each selected service so that a
# companion script can read it and apply the desired scale config / patch / CR
# update. It is NOT consumed directly by cpd-cli as a single param-file; instead
# it serves as a per-component reference of:
#   - the scaling METHOD (cpd-cli apply-scale-config / apply-cluster-component-
#     scale-config / update-cr / oc patch / web client / IBM Sales sizing)
#   - the valid LEVELS or SIZES
#   - the cpd-cli `--components` (or CR) name to target
#   - a desired value you can edit, expressed under <component>: { scale: ... }
#
# Scale LEVELS (services using `--scale`):
#   level_1 - Minimal CPU reservation. Low concurrency, frees CPU when idle.
#             No resiliency (no redundant replicas).
#   level_2 - Small workloads. Minimum recommended footprint, growth capped.
#             No resiliency guaranteed.
#   level_3 - Resiliency + concurrency. Moderate workloads, reasonable redundancy.
#   level_4 - High availability with large workloads. Better resiliency.
#   level_5 - HA with large workloads + more concurrency. Max resiliency/redundancy.
#
# Scale SIZES (services using a size string instead of a level):
#   x-small / xsmall      - PoC / smallest footprint (where supported)
#   small_mincpureq       - Minimal reserved CPU without removing the CPU pod setting
#   small                 - Default for most size-based services
#   medium
#   large
#
# General notes:
#   - Set --wait=false on cpd-cli to patch the CR and return immediately.
#   - To scale several services to the same level at once:
#       cpd-cli manage apply-scale-config --components=zen,dp,ws --scale=level_3
#   - When scaling a service, also scale its related/dependency services.
#   - To override a non-default CR name, use a --param-file with:
#       override_components_meta:
#         <component-name>:
#           cr_name: <your-cr-name>
#   - Check current scale: cpd-cli manage get-scale-config --components=<name>
#     (Scheduling service uses get-cluster-component-scale-config instead.)
#
# Per-component keys below:
#   <component>:
#     method:     scaling method identifier (for the apply script to branch on)
#     component:  cpd-cli --components value or CR kind to target
#     scale:      desired level / size (EDIT THIS)
################################################################################

# ==============================================================================
# Method 1: cpd-cli manage apply-scale-config  (uses --scale=level_1..level_5)
# ==============================================================================
{% if "cpd_platform" in components_to_install %}
---
# ............................................................................
# IBM Software Hub control plane
#   cpd-cli manage apply-scale-config \
#     --cpd_instance_ns=${PROJECT_CPD_INST_OPERANDS} \
#     --components=zen --scale=${SCALE}
# ............................................................................
zen:
  method: apply-scale-config
  component: zen
  scale: level_1
{% endif %}{% if "canvasbase" in components_to_install or "spss" in components_to_install or "synthetic_data_generator" in components_to_install %}
