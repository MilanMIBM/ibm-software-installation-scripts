  component: scheduler
  scale: level_1
{% endif %}

# ==============================================================================
# Method 3: cpd-cli manage update-cr  (size string, not a level)
#   Valid sizes: small_mincpureq, small (default), medium, large
# ==============================================================================
{% if "watsonx_governance" in components_to_install %}
---
# ............................................................................
# watsonx.governance
#   cpd-cli manage update-cr \
#     --component=watsonx_governance \
#     --cpd_instance_ns=${PROJECT_CPD_INST_OPERANDS} \
#     --patch="{\"scaleConfig\":\"${SIZE}\"}"
#   Note: scaling up/down also passes the value to downstream services
#   such as AI Factsheets and OpenPages.
# ............................................................................
watsonx_governance:
  method: update-cr-size
  component: watsonx_governance
  scale: small          # small_mincpureq | small | medium | large
{% endif %}{% if "watson_speech" in components_to_install %}
---
# ............................................................................
# Watson Speech services (STT & TTS scaled independently)
#   Valid sizes: xsmall (default), small_mincpureq, small, medium, large
#   Watson Speech to Text:
#     cpd-cli manage update-cr --component=watson_speech \
#       --cpd_instance_ns=${PROJECT_CPD_INST_OPERANDS} \
#       --patch="{\"scaleConfig\":{\"stt\":{\"size\":\"${SIZE}\"}}}"
#   Watson Text to Speech:
#     cpd-cli manage update-cr --component=watson_speech \
#       --cpd_instance_ns=${PROJECT_CPD_INST_OPERANDS} \
#       --patch="{\"scaleConfig\":{\"tts\":{\"size\":\"${SIZE}\"}}}"
# ............................................................................
watson_speech:
  method: update-cr-stt-tts
  component: watson_speech
  scale:
    stt: xsmall         # xsmall | small_mincpureq | small | medium | large
    tts: xsmall         # xsmall | small_mincpureq | small | medium | large
{% endif %}

# ==============================================================================
# Method 4: oc patch  (size string into the instance CR)
# ==============================================================================
{% if "planning_analytics" in components_to_install %}
---
# ............................................................................
# Planning Analytics  (per service instance)
#   Valid sizes: small_mincpureq, small (default), medium, large
#   export INSTANCE_NAME=<instance-name>
#   oc patch PAServiceInstance ${INSTANCE_NAME} \
#     --namespace ${PROJECT_CPD_INST_OPERANDS} \
#     --patch '{"spec":{"scaleConfig":"'${SIZE}'"}}' --type=merge
# ............................................................................
planning_analytics:
  method: oc-patch-pa
  component: PAServiceInstance
  instance_name: ""       # REQUIRED: set the PA service instance name
  scale: small            # small_mincpureq | small | medium | large
{% endif %}

# ==============================================================================
# Method 5: oc patch / oc scale  (replicas and/or CPU+memory, no scale levels)
# ==============================================================================
{% if "voice_gateway" in components_to_install %}
---
# ............................................................................
# Voice Gateway  (scale by replica count, per instance)
#   oc get voicegateway --namespace ${PROJECT_CPD_INST_OPERANDS}
#   export INSTANCE_NAME=<instance-name>
#   oc scale voicegateway ${INSTANCE_NAME} \
#     --namespace ${PROJECT_CPD_INST_OPERANDS} --replicas=${REPLICAS}
# ............................................................................
voice_gateway:
  method: oc-scale-replicas
  component: voicegateway
  instance_name: ""       # REQUIRED: set the Voice Gateway instance name
  replicas: 1
{% endif %}{% if "informix" in components_to_install or "informix_cp4d" in components_to_install %}
---
# ............................................................................
# Informix  (no scale levels; patch replicas and/or CPU/memory per instance)
#   export INSTANCE_ID=<instance-id>
#   # replicas (server count):
#   oc patch Informixes informix-${INSTANCE_ID} \
#     --namespace ${PROJECT_CPD_INST_OPERANDS} \
#     --patch '{"spec":{"replicas":2}}' --type=merge
#   # resources (limits/requests for cpu/memory):
#   oc patch Informixes informix-${INSTANCE_ID}-server \
#     --namespace ${PROJECT_CPD_INST_OPERANDS} \
#     --patch '{"spec":{"resources":{"limits":{"memory":"4Gi"}}}}' --type=merge
#   # then delete the StatefulSet for changes to take effect:
#   oc delete sts informix-${INSTANCE_ID}-server
# ............................................................................
informix:
  method: oc-patch-resources
  component: Informixes
  instance_id: ""         # REQUIRED: set the Informix instance id
  replicas: 1
  resources:
    requests:
      cpu: "2"
      memory: "2Gi"
    limits:
      cpu: "4"
      memory: "4Gi"
{% endif %}

# ==============================================================================
# Method 6: Instance provisioning size / web client  (no cpd-cli scale config)
#   These services are sized at provisioning time and/or scaled from the
#   IBM Software Hub web client. No scale-config file applies; documented here
#   for completeness so the apply script can skip/warn appropriately.
# ==============================================================================
{% if "cognos_analytics" in components_to_install %}
---
# ............................................................................
# Cognos Analytics
#   Sized when provisioning an instance; change via the web client.
#   Supported sizes: fixed minimum (no scale), xsmall, small_mincpureq,
#   small, medium, large
# ............................................................................
cognos_analytics:
  method: provision-size-webclient
  component: cognos_analytics
  scale: small            # informational only
{% endif %}{% if "data_gate" in components_to_install or "datagate" in components_to_install %}
---
# ............................................................................
# Data Gate
#   Sized per instance. Supported sizes:
#   small_mincpureq (default), small (default), medium, large
# ............................................................................
data_gate:
  method: provision-size-instance
  component: data_gate
  scale: small            # informational only
{% endif %}{% if "dv" in components_to_install %}
---
# ............................................................................
# Data Virtualization
#   Cannot be scaled directly with the scale setting. Instead use the scale
#   setting on the underlying bigsql / db2u-dv CR in the DV instance.
#   See: Scaling Data Virtualization.
# ............................................................................
dv:
  method: special-bigsql-cr
  component: dv
  scale: level_1          # applied to the underlying bigsql / db2u-dv CR
{% endif %}{% if "bigsql" in components_to_install %}
---
# ............................................................................
# Db2 Big SQL
#   Scaled from the instance details page in the web client.
#   See: Configuring a Db2 Big SQL instance.
# ............................................................................
bigsql:
  method: webclient-instance
  component: bigsql
  scale: ""               # informational only (no cpd-cli scale config)
{% endif %}

