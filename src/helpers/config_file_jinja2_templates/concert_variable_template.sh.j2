{#- Secrets (incl. *_OC_LOGIN commands, which carry tokens) are single-quoted so a
    '$' stays literal; everything else is double-quoted so values may reference
    earlier exports, e.g. CONCERT_STG_CLASS_HUB="${CONCERT_STG_CLASS_BLOCK}". -#}
{%- macro shell_value(key, value) -%}
{%- set v = (value if value is not none else "") | string -%}
{%- if key.endswith("PASSWORD") or key.endswith("_KEY") or key.endswith("TOKEN") or key.endswith("_OC_LOGIN") -%}
'{{ v | replace("'", "'\\''") }}'
{%- else -%}
"{{ v | replace('\\', '\\\\') | replace('"', '\\"') | replace('`', '\\`') }}"
{%- endif -%}
{%- endmacro -%}
{%- macro export_block(vars) -%}
{% for key, value in vars.items() -%}
export {{ key }}={{ shell_value(key, value) }}
{% endfor -%}
{%- endmacro -%}
#!/bin/zsh
# ==============================================================================
# IBM Concert configuration - generated by ibm_concert_vars_generation.py
# ==============================================================================
# Sourced (never executed) by scripts/install_ibm_concert/*, which all run with
# ENV_TARGET=concert. Everything below is skipped otherwise, so CP4D scripts
# that source every configs/*/*.sh never pick up Concert's cluster login,
# registry credentials or SERVICE_MESH_VERSION.
#
#   Interactive shell:  ENV_TARGET=concert source s_env.sh
#
# Plan / decisions: .claude/plans/ibm-concert-installation-plan.md
[[ "${ENV_TARGET:-}" == concert || "${ENV_TARGET:-}" == *concert_vars.sh ]] || return 0

# ------------------------------------------------------------------------------
# Cluster
# ------------------------------------------------------------------------------
export OCP_URL="{{ cluster_url_input.value }}"
{% if login_argument_select.selected_key == "Username/Password" -%}
export OCP_USERNAME="{{ cluster_username_input.value }}"
export OCP_PASSWORD={{ shell_value("OCP_PASSWORD", cluster_password_input.value) }}
{% else -%}
export OCP_TOKEN={{ shell_value("OCP_TOKEN", cluster_token_input.value) }}
{% endif -%}
export SERVER_ARGUMENTS="--server=${OCP_URL}"
# Single quotes: the credentials are expanded when OC_LOGIN is eval'd, so a
# password containing $ ' or " still logs in.
{% if login_argument_select.selected_key == "Username/Password" -%}
export LOGIN_ARGUMENTS='--username="${OCP_USERNAME}" --password="${OCP_PASSWORD}"'
{% else -%}
export LOGIN_ARGUMENTS='--token="${OCP_TOKEN}"'
{% endif -%}
# Every script runs eval "${OC_LOGIN}" before touching the cluster.
export OC_LOGIN="oc login ${SERVER_ARGUMENTS} ${LOGIN_ARGUMENTS}"

# ------------------------------------------------------------------------------
# Release, profile and runner
# ------------------------------------------------------------------------------
# CONCERT_VERSION, never VERSION: the shared Service Mesh helper reads VERSION.
{{ export_block(concert_release) -}}
{{ export_block(concert_runner) }}
# ------------------------------------------------------------------------------
# Images
# ------------------------------------------------------------------------------
export IBM_ENTITLEMENT_KEY={{ shell_value("IBM_ENTITLEMENT_KEY", ibm_entitlement_key_input.value) }}
{{ export_block(concert_images) }}
# ------------------------------------------------------------------------------
# Products and Hub
# ------------------------------------------------------------------------------
{{ export_block(concert_products) -}}
{{ export_block(concert_hub) }}
# ------------------------------------------------------------------------------
# Namespaces (PROJECT_* - generic utilities pick them up)
# ------------------------------------------------------------------------------
{{ export_block(concert_namespaces) }}
# ------------------------------------------------------------------------------
# Sizing ({{ concert_release.get("CONCERT_PROFILE") }} profile) and storage
# ------------------------------------------------------------------------------
{{ export_block(concert_sizing) -}}
{{ export_block(concert_storage) }}
# ------------------------------------------------------------------------------
# Workflows (Istio and FaaS are mutually exclusive)
# ------------------------------------------------------------------------------
{{ export_block(concert_workflows) }}
# ------------------------------------------------------------------------------
# AI and Secure Coder (manual values, sent to the installer as env vars)
# ------------------------------------------------------------------------------
{{ export_block(concert_ai) -}}
{{ export_block(concert_securecoder) }}
# ------------------------------------------------------------------------------
# Initial Concert admin (Keycloak) - never IBM's ibmconcert/password default
# ------------------------------------------------------------------------------
{{ export_block(concert_admin) }}
# ------------------------------------------------------------------------------
# Concert Optimize - Turbonomic (5_install_optimize, when CONCERT_INSTALL_OPTIMIZE)
# ------------------------------------------------------------------------------
# Version from IBM's Concert platform matrix (Hub 3.0.3 <-> Turbonomic 8.21.2).
# OAUTH2_AUDIENCE: IBM's t8c-operator samples use CONCERT, IBM's Optimize docs
# page the Hub URL - unverified which the Hub expects.
{{ export_block(concert_optimize) }}
# ------------------------------------------------------------------------------
# Data stores
# ------------------------------------------------------------------------------
# Consumers: external = a store outside IBM's built-in one (provisioned or
# existing); internal = IBM's built-in (dev/test grade). The choice is fixed
# after the first install of the product (IBM rule).
{{ export_block(concert_ds_consumers) }}
# Servers: provision = created by 2_prepare_cluster/2.3*, existing = values below
{{ export_block(concert_ds_providers) }}
# ---- PostgreSQL (CloudNativePG when provisioned) -----------------------------
{{ export_block(concert_ds_postgres) }}
# ---- S3 (ODF Multicloud Object Gateway when provisioned) ---------------------
# CONCERT_DS_S3_CW_AUTH_TYPE: Workflows requires a value; IBM does not document
# the accepted ones - unverified default (plan spike S7).
{{ export_block(concert_ds_s3) }}
# ---- MySQL / Redis / Neo4j / RabbitMQ ----------------------------------------
{{ export_block(concert_ds_other) }}
# ------------------------------------------------------------------------------
# Optional local overrides (not generated): configs/concert_config/.env
# Sourced before the derived values below so an override is reflected in them.
_CONCERT_VARS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-${(%):-%x}}")" && pwd)"
[[ -f "${_CONCERT_VARS_DIR}/.env" ]] && source "${_CONCERT_VARS_DIR}/.env"
unset _CONCERT_VARS_DIR

# ------------------------------------------------------------------------------
# Derived - do not edit
# ------------------------------------------------------------------------------
if [[ "${CONCERT_IMAGE_SOURCE}" == entitled ]]; then
    export CONCERT_REG_USER="cp"
    export CONCERT_IMAGE_REGISTRY_PREFIX="cp.icr.io/cp"
    export CONCERT_REGISTRY_PASSWORD="${IBM_ENTITLEMENT_KEY}"
else
    # 1_registry_access_and_mirroring/1.1 keeps IBM's layout:
    # <registry>/cp/platform-hub/<image> and <registry>/cp/concert/<image>
    export CONCERT_REG_USER="${PRIVATE_REGISTRY_PULL_USER}"
    export CONCERT_IMAGE_REGISTRY_PREFIX="${PRIVATE_REGISTRY_LOCATION}/cp"
    export CONCERT_REGISTRY_PASSWORD="${PRIVATE_REGISTRY_PULL_PASSWORD}"
fi

# One-off target switch (e.g. the remote Hub cluster in 4_post_install/4.3):
#   CONCERT_TARGET_OC_LOGIN="${CONCERT_REMOTE_HUB_OC_LOGIN}" ./<script>.sh
# OCP_URL is cleared so source_env_setup.sh does not skip the login because the
# session already points at this config's own cluster.
if [[ -n "${CONCERT_TARGET_OC_LOGIN:-}" ]]; then
    export OC_LOGIN="${CONCERT_TARGET_OC_LOGIN}"
    export OCP_URL=""
fi
return 0
