# One independently runnable install. A StatefulSet, not a Deployment: it starts no
# replacement until the old pod is confirmed gone, so two copies of a chain can
# never run at once. No liveness probe (a false positive would kill a healthy
# install) and no PodDisruptionBudget (it would stall node drains; the step
# journal handles eviction instead).
apiVersion: v1
kind: Namespace
metadata:
  name: @NAMESPACE@
  labels:
    app.kubernetes.io/managed-by: install-runner
    install-runner/slot: @SLOT@
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: install-runner
  namespace: @NAMESPACE@
  labels:
    app.kubernetes.io/managed-by: install-runner
---
# Survives the end of a run, when cluster-admin has gone: status keeps working.
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: install-runner-status
  namespace: @NAMESPACE@
  labels:
    app.kubernetes.io/managed-by: install-runner
rules:
- apiGroups: [""]
  resources: ["configmaps"]
  verbs: ["get", "create", "update", "patch"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: install-runner-status
  namespace: @NAMESPACE@
  labels:
    app.kubernetes.io/managed-by: install-runner
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: install-runner-status
subjects:
- kind: ServiceAccount
  name: install-runner
  namespace: @NAMESPACE@
---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: install-runner
  namespace: @NAMESPACE@
  labels:
    app.kubernetes.io/managed-by: install-runner
    install-runner/slot: @SLOT@
spec:
  replicas: 1
  serviceName: install-runner
  selector:
    matchLabels:
      app.kubernetes.io/name: install-runner
  template:
    metadata:
      labels:
        app.kubernetes.io/name: install-runner
        install-runner/slot: @SLOT@
      annotations:
        # cluster-admin would otherwise get anyuid (UID 1001, no fsGroup), which
        # cannot write the volume; restricted-v2 sets a writable fsGroup.
        openshift.io/required-scc: restricted-v2@POD_ANNOTATIONS_EXTRA@
    spec:
      serviceAccountName: install-runner@POD_SPEC_EXTRA@
      terminationGracePeriodSeconds: 120
      nodeSelector: @NODE_SELECTOR@@INIT_CONTAINERS@
      containers:
      - name: runner
        image: @IMAGE@
        imagePullPolicy: IfNotPresent
        env:
        - name: IR_SLOT
          value: "@SLOT@"
        - name: IR_NAMESPACE
          valueFrom:
            fieldRef:
              fieldPath: metadata.namespace
        - name: IR_OCP_URL
          value: "@OCP_URL@"
        # The multi-cluster name the slot was launched from, for status only. Never
        # MCM_CLUSTER: that would pin the pod (plan §5).
        - name: IR_SOURCE_CLUSTER
          value: "@SOURCE_CLUSTER@"
        - name: IR_AUTO_RESUME
          value: "@AUTO_RESUME@"
        - name: IR_MAX_RESUMES
          value: "@MAX_RESUMES@"
        - name: IR_KEEP_ADMIN
          value: "@KEEP_ADMIN@"
        - name: IR_ADMIN_BINDING
          value: "@ADMIN_BINDING@"
        - name: IR_TTY_SIZE
          value: "@TTY_SIZE@"
        - name: TMPDIR
          value: /work/tmp@RUNNER_ENV_EXTRA@
        securityContext:
          allowPrivilegeEscalation: false
          runAsNonRoot: true
          capabilities:
            drop: ["ALL"]
          seccompProfile:
            type: RuntimeDefault
        resources:
          requests:
            cpu: "@CPU_REQUEST@"
            memory: "@MEMORY_REQUEST@"
          limits:
            memory: "@MEMORY_LIMIT@"
        volumeMounts:
        - name: work
          mountPath: /work@RUNNER_MOUNTS_EXTRA@@SIDECARS@
      volumes:
      - name: work
        persistentVolumeClaim:
          claimName: install-runner-work@VOLUMES_EXTRA@
