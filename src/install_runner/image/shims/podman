#!/bin/bash
# =============================================================================
# podman shim for the in-cluster install runner
# -----------------------------------------------------------------------------
# The repo reaches the olm-utils container with a few podman verbs. The pod is
# that container, so they map onto the local filesystem. Anything else fails
# loudly: a silent success here would hide a step that cannot work in a pod.
# =============================================================================
fail() { echo "[ERROR] podman $* is not supported in the in-cluster runner." >&2; exit 125; }
verb="${1:-}"
[[ -n "${verb}" ]] && shift

# Control Center steps (swhcc_activate sets IR_EXEC_ROUTE=swhcc) name the side
# container IR_EXEC_CONTAINER_NAME. In a pod that container is the premium sidecar,
# so its verbs answer for it: exec goes to swhcc-exec, inspect reports its image,
# and image checks are only true for that image. Other names stay as below.
routed() { [[ "${IR_EXEC_ROUTE:-}" == swhcc && -n "${IR_EXEC_CONTAINER_NAME:-}" ]]; }
routed_image() {   # <image>
    [[ "$1" == "${IR_SWHCC_IMAGE_SOURCE:-}" ]] && exit 0
    echo "[ERROR] podman: the Control Center sidecar runs ${IR_SWHCC_IMAGE_SOURCE:-no image}, not $1. Launch the run again to change it." >&2
    exit 1
}

case "${verb}" in
    exec)
        declare -a envs=()
        workdir=""
        while [[ "${1:-}" == -* ]]; do
            case "$1" in
                -e|--env)         envs+=("$2"); shift 2 ;;
                --env=*)          envs+=("${1#*=}"); shift ;;
                -w|--workdir)     workdir="$2"; shift 2 ;;
                --workdir=*)      workdir="${1#*=}"; shift ;;
                -i|-t|-it|-ti|--interactive|--tty) shift ;;
                *) fail exec "$1" ;;
            esac
        done
        name="${1:-}"
        shift   # the container name
        (( $# )) || fail exec "(no command)"
        if routed && [[ "${name}" == "${IR_EXEC_CONTAINER_NAME}" ]]; then
            declare -a args=()
            [[ -n "${workdir}" ]] && args+=(--cwd "${workdir}")
            for kv in "${envs[@]}"; do
                # -e NAME passes this process's value, as podman does.
                [[ "${kv}" == *=* ]] || kv="${kv}=${!kv:-}"
                args+=(--env "${kv}")
            done
            exec swhcc-exec "${args[@]}" -- "$@"
        fi
        [[ -n "${workdir}" ]] && { cd "${workdir}" || exit 126; }
        (( ${#envs[@]} )) && export "${envs[@]}"
        exec "$@"
        ;;
    inspect)
        if routed && [[ " $* " == *" ${IR_EXEC_CONTAINER_NAME} "* ]]; then
            case "$*" in
                *ImageName*|*Config.Image*) echo "${IR_SWHCC_IMAGE_SOURCE:-}"; exit 0 ;;
            esac
        fi
        case "$*" in
            *ImageName*|*Config.Image*) echo "${OLM_UTILS_IMAGE:-}" ;;
            *State.Status*|*.State*)    echo running ;;
            *) fail inspect "$@" ;;
        esac
        ;;
    image)
        if [[ "${1:-}" == exists ]]; then
            routed && routed_image "${2:-}"
            exit 0
        fi
        fail image "$@"
        ;;
    pull)
        routed && routed_image "${@: -1}"
        exit 0 ;;   # the pod runs from the image already
    create)
        # A throwaway container reads files out of the image; this filesystem is it.
        echo "install-runner-self"
        ;;
    cp)
        # podman cp <container>:<path> <dest>
        [[ "${1:-}" == *:* && $# -eq 2 ]] || fail cp "$@"
        cp -R "${1#*:}" "$2"
        ;;
    rm)     exit 0 ;;
    ps)     echo "${OLM_UTILS_CONTAINER:-olm-utils-play-v4}" ;;
    info|version|--version) echo "install-runner podman shim" ;;
    *)      fail "${verb}" "$@" ;;
esac
