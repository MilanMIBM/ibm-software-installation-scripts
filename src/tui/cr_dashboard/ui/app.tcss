/* cr-dashboard layout. Dot colours are the $dot-* variables (DashboardApp.get_css_variables). */

Screen {
    layout: vertical;
}

#status {
    height: 1;
    padding: 0 1;
}
#status GlowDot {
    margin-left: 1;
}
#status .count {
    width: auto;
    margin: 0 2 0 0;
}
#status #updated {
    width: 1fr;
    content-align: right middle;
    color: $text-muted;
}

#root-problem {
    height: auto;
    max-height: 3;
    padding: 0 1;
    color: $text;
}
#root-problem.-none {
    color: $text-muted;
}

#main {
    height: 1fr;
}
ChainView {
    width: 47%;
}
CRList {
    width: 1fr;
}

#events {
    height: 6;
    border: round $panel-lighten-2;
    border-title-color: $text-muted;
    padding: 0 1;
}

#search {
    dock: bottom;
    display: none;
}
#search.-visible {
    display: block;
}
